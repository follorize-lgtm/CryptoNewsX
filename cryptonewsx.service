[Unit]
Description=CryptoNewsX cross-poster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cnx
Group=cnx
WorkingDirectory=/opt/cryptonewsx
EnvironmentFile=/opt/cryptonewsx/.env
ExecStart=/opt/cryptonewsx/venv/bin/python main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
