TELEGRAM_BOT_TOKEN=
# One or more numeric Telegram user IDs. Separate multiple IDs with commas.
# /setup works only for these users in private chat.
OWNER_TELEGRAM_IDS=123456789,987654321
# Backward compatible: OWNER_TELEGRAM_ID is also supported.

SOURCE_CHANNELS=-1001234567890,mychannelusername

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Switch to publer after setting a Business/Enterprise API key with posts/media
# scopes and connecting the X account in the workspace.
X_POST_PROVIDER=direct
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=
PUBLER_X_ACCOUNT_ID=
PUBLER_X_LONG_POST=false
PUBLER_X_STATE_DB=publer-x-state.sqlite3

# Use the same private Schedchie OAuth connection as Wabble. This replaces
# direct X API delivery when X's direct API credits are exhausted.
# Set X_POST_PROVIDER=schedchie to activate.
SCHEDCHIE_X_ACCOUNT_ID=
SCHEDCHIE_CREDENTIALS_FILE=
SCHEDCHIE_MEDIA_BASE_URL=
SCHEDCHIE_MEDIA_UPLOAD_URL=
SCHEDCHIE_MEDIA_UPLOAD_TOKEN=
SCHEDCHIE_X_STATE_DB=schedchie-x-state.sqlite3

MAX_HASHTAGS=2
MIN_INTERVAL_SECONDS=45
ALBUM_WAIT_SECONDS=2
THREAD_INTERVAL_SECONDS=2
