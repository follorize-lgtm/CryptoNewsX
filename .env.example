TELEGRAM_BOT_TOKEN=

SOURCE_CHANNELS=-1001234567890,mychannelusername

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

MAX_HASHTAGS=2
MIN_INTERVAL_SECONDS=45
ALBUM_WAIT_SECONDS=2
THREAD_INTERVAL_SECONDS=2

# Official Instagram/TikTok multi-account publishing. Tokens are stored in this
# mode-0600 runtime data file, never in Git or in .env.
SOCIAL_ACCOUNTS_FILE=/opt/cryptonewsx/data/accounts.json
SOCIAL_MAX_WORKERS=4
INSTAGRAM_API_VERSION=v24.0

# One TikTok developer app serves every connected TikTok account. Each account
# still approves OAuth once, as required by TikTok.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/tiktok/callback
